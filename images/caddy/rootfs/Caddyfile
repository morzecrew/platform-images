{
	{$CADDY_AUTO_HTTPS}
	order coraza_waf after rate_limit

	import {$CADDY_SERVERS_DIR}/*.caddy
}

import {$CADDY_BUILTIN_SNIPPETS_DIR}/*.caddy
import {$CADDY_SNIPPET_DEFS_DIR}/*.caddy

{$CADDY_EDGE_ADDRESS} {
	encode zstd gzip

	handle {$CADDY_HEALTH_PATH} {
		respond "ok" 200
	}

	request_body {
		max_size {$CADDY_REQUEST_BODY_MAX_SIZE}
	}

	coraza_waf {
		directives `
		Include /opt/coraza/config/coraza.conf
		SecRequestBodyLimit {$CADDY_WAF_REQUEST_BODY_LIMIT:30000000}
		Include /opt/coraza/config/crs-setup.conf
		Include /opt/coraza/overrides/*.conf
		SecRuleEngine {$CADDY_WAF_ENGINE}
		Include /opt/coraza/owasp-crs/*.conf
		`
	}

	import {$CADDY_CONFIG_DIR}/*.caddy

	# Marks the WAF's 403, and no other, with Coraza's unique_id from the audit
	# log. A fragment's own handle_errors still writes the response.
	handle_errors 403 {
		@waf expression `{err.message} == "interruption triggered"`
		header @waf X-Waf-Blocked {err.id}
	}

	handle {
		respond "No configuration injected" 501
	}
}
