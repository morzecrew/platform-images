+		binary.BigEndian.PutUint16(out[17:19], uint16(port))
+		return out, nil
+	}
+	if len(host) == 0 || len(host) > 255 {
+		return nil, fmt.Errorf("socks5 udp: bad destination host %q", host)
+	}
